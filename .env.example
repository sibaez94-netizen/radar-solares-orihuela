# ============================================================================
# CONFIGURACIÓN DE CORREO (GMAIL) PARA LEER ALERTAS DE IDEALISTA/FOTOCASA
# Y RECIBIR EL INFORME DIARIO DE CHOLLOS (NO REQUIERE API DE PAGO)
# ============================================================================
# ¿Cómo sacar los 16 caracteres de IMAP_PASSWORD / SMTP_PASSWORD en 30 segundos?
# 1. Entra en https://myaccount.google.com/apppasswords
# 2. Pon de nombre "Agente Solares" y copia las 16 letras que te da Google.
# 3. Renombra este archivo de ".env.example" a ".env" y pega tus datos aquí:

IMAP_HOST=imap.gmail.com
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

NOTIFY_EMAIL=tu_correo@gmail.com
DASHBOARD_URL=https://tu-usuario.github.io/radar-solares-orihuela/
